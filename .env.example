# 飞书应用配置（在飞书开放平台创建应用获取）
FEISHU_APP_ID=你的App_ID
FEISHU_APP_SECRET=你的App_Secret

# 飞书多维表格配置
BITABLE_APP_TOKEN=你的表格Token
BITABLE_TABLE_ID=你的表格Table_ID

# Chrome Cookie 路径（用于小红书登录态）
# macOS 默认路径，一般不需要改
# CHROME_COOKIE_PATH=~/Library/Application Support/Google/Chrome/Default/Cookies

# 小红书下载器 Cookie（用于下载笔记内容）
# XHS_COOKIE_FILE=~/.config/xhs-downloader/cookie.txt

# 下载目录
# DOWNLOAD_DIR=~/Downloads/xhs

# 搜索间隔秒数（防风控，建议 ≥ 5）
# SLEEP_BETWEEN=8
